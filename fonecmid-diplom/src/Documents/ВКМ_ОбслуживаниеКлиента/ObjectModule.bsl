#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
    СформироватьУведомлениеПриЗаписи();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ,Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	//Данный фрагмент построен конструктором.
	//При повторном использовании конструктора, внесенные вручную данные будут утеряны!

	// регистр ВКМ_ВыполненныеКлиентуРаботы

	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	
	
	ПроверитьДоговор(Отказ);
    
    Если Отказ Тогда
        Возврат;
    КонецЕсли;
	
	СтавкаЧаса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВКМ_СтоимостьЧасаРаботы");
	ЧасыКОплате = ВыполненныеРаботы.Итог("ЧасыКОплатеКлиенту");
	
	Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
	
	Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
    Движение.Период = Дата;
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Движение.Клиент = Клиент;
    Движение.Договор = Договор;
    Движение.КоличествоЧасов = ЧасыКОплате;
    Движение.СуммаКОплате = ЧасыКОплате * СтавкаЧаса;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДоговор(Отказ)
   Отказ = Ложь;
    
   Если Не ЗначениеЗаполнено(Договор) Тогда
	   	ОбщегоНазначения.СообщитьПользователю("Не указан договор.",, "Договор", "Объект.Договор", Отказ);
	   	Возврат;
	КонецЕсли;

	ЗначРекДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора, ВКМ_ДатаНачала, ВКМ_ДатаОкончания", Отказ);
	
	Если ЗначРекДоговора.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание Тогда
	    ОбщегоНазначения.СообщитьПользователю("Вид договора не соответсвует, необходимо выбрать договор абонентского обслуживания.",, "Договор", "Объект.Договор", Отказ);
	    Возврат;
	КонецЕсли;
	Если Дата < ЗначРекДоговора.ВКМ_ДатаНачала Или Дата > ЗначРекДоговора.ВКМ_ДатаОкончания Тогда
	   	ОбщегоНазначения.СообщитьПользователю("Дата документа не входит в период действия договора.",, "Дата", "Объект.Дата", Отказ);
	    Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура СформироватьУведомлениеПриЗаписи()

    СтарыеДанные = ВКМ_ПолучитьСтарыеДанныеДляУведомления();

    Если СтарыеДанные.ЭтоНовый Тогда
	
	    Текст = "Запланировано новое обслуживание клиента." + Символы.ПС
			    + "Клиент: "      + Строка(Клиент)     + Символы.ПС
			    + "Договор: "     + Строка(Договор)    + Символы.ПС
			    + "Специалист: "  + Строка(Специалист) + Символы.ПС
			    + "Дата: "        + Формат(ДатаПроведенияРабот, "ДФ=dd.MM.yyyy") + Символы.ПС
			    + "Время: "       + Формат(ВремяНачалаРабот, "ДФ=HH:mm")
			    + " - " + Формат(ВремяОкончанияРабот, "ДФ=HH:mm");
		ЗаписатьУведомление(Текст);
	    Возврат;

    КонецЕсли;

    ИзмененаДата          = (СтарыеДанные.ДатаПроведенияРабот <> ДатаПроведенияРабот);
    ИзмененоВремяНачала   = (СтарыеДанные.ВремяНачалаРабот     <> ВремяНачалаРабот);
    ИзмененоВремяОкончания = (СтарыеДанные.ВремяОкончанияРабот  <> ВремяОкончанияРабот);
    ИзмененСпециалист     = (СтарыеДанные.Специалист            <> Специалист);

    Если Не (ИзмененаДата Или ИзмененоВремяНачала
            Или ИзмененоВремяОкончания Или ИзмененСпециалист) Тогда
        Возврат;
    КонецЕсли;

    Текст = "Изменено обслуживание клиента." + Символы.ПС;

    Если ИзмененаДата Тогда
        Текст = Текст + "Дата: "
            + Формат(СтарыеДанные.ДатаПроведенияРабот, "ДФ=dd.MM.yyyy")
            + " -> " + Формат(ДатаПроведенияРабот, "ДФ=dd.MM.yyyy") + Символы.ПС;
    КонецЕсли;

    Если ИзмененоВремяНачала Тогда
        Текст = Текст + "Время начала: "
            + Формат(СтарыеДанные.ВремяНачалаРабот, "ДФ=HH:mm")
            + " -> " + Формат(ВремяНачалаРабот, "ДФ=HH:mm") + Символы.ПС;
    КонецЕсли;

    Если ИзмененоВремяОкончания Тогда
        Текст = Текст + "Время окончания: "
            + Формат(СтарыеДанные.ВремяОкончанияРабот, "ДФ=HH:mm")
            + " -> " + Формат(ВремяОкончанияРабот, "ДФ=HH:mm") + Символы.ПС;
    КонецЕсли;

    Если ИзмененСпециалист Тогда
        Текст = Текст + "Специалист: "
            + Строка(СтарыеДанные.Специалист)
            + " -> " + Строка(Специалист) + Символы.ПС;
    КонецЕсли;

    ЗаписатьУведомление(Текст);

КонецПроцедуры

Функция ВКМ_ПолучитьСтарыеДанныеДляУведомления()

    Результат = Новый Структура;
    Результат.Вставить("ЭтоНовый", Этоновый());

    Если Этоновый() Тогда
        Возврат Результат;
    КонецЕсли;

    СтарыйОбъект = Ссылка.ПолучитьОбъект();

    Результат.Вставить("ДатаПроведенияРабот", СтарыйОбъект.ДатаПроведенияРабот);
    Результат.Вставить("ВремяНачалаРабот",     СтарыйОбъект.ВремяНачалаРабот);
    Результат.Вставить("ВремяОкончанияРабот",  СтарыйОбъект.ВремяОкончанияРабот);
    Результат.Вставить("Специалист",           СтарыйОбъект.Специалист);

    Возврат Результат;

КонецФункции

Процедура ЗаписатьУведомление(ТекстСообщения)

    Уведомление = Справочники.ВКМ_УведомленияТелеграмБоту.СоздатьЭлемент();
    Уведомление.ВКМ_ТекстСообщения = ТекстСообщения;
    Уведомление.Записать();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
