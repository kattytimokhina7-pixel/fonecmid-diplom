#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
    ВКМ_СформироватьУведомлениеПриЗаписи();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ,Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	//Данный фрагмент построен конструктором.
	//При повторном использовании конструктора, внесенные вручную данные будут утеряны!

	// регистр ВКМ_ВыполненныеКлиентуРаботы

	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	
	
	ВКМ_ПроверитьДоговор(Отказ);
    
    Если Отказ Тогда
        Возврат;
    КонецЕсли;
	
	СтавкаЧаса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВКМ_Договор, "ВКМ_СтоимостьЧасаРаботы");
	ЧасыКОплате = ВКМ_ВыполненныеРаботы.Итог("ВКМ_ЧасыКОплатеКлиенту");
	
	Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
	
	Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
    Движение.Период = Дата;
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Движение.ВКМ_Клиент = ВКМ_Клиент;
    Движение.ВКМ_Договор = ВКМ_Договор;
    Движение.ВКМ_КоличествоЧасов = ЧасыКОплате;
    Движение.ВКМ_СуммаКОплате = ЧасыКОплате * СтавкаЧаса;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВКМ_ПроверитьДоговор(Отказ)
    
   Если Не ЗначениеЗаполнено(ВКМ_Договор) Тогда
	   	ОбщегоНазначения.СообщитьПользователю("Не указан договор.",, "ВКМ_Договор", "Объект.ВКМ_Договор");
	   	Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЗначВКМ_Договор = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВКМ_Договор, "ВидДоговора, ВКМ_ДатаНачала, ВКМ_ДатаОкончания");
	
	Если ЗначВКМ_Договор.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание Тогда
	    ОбщегоНазначения.СообщитьПользователю("Вид договора не соответсвует, необходимо выбрать договор абонентского обслуживания.",, "ВКМ_Договор", "Объект.ВКМ_Договор");
	    Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Дата < ЗначВКМ_Договор.ВКМ_ДатаНачала Или Дата > ЗначВКМ_Договор.ВКМ_ДатаОкончания Тогда
	   	ОбщегоНазначения.СообщитьПользователю("Дата документа не входит в период действия договора.",, "Дата", "Объект.Дата");
	    Отказ = Истина;
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура ВКМ_СформироватьУведомлениеПриЗаписи()

    СтарыеДанные = ВКМ_ПолучитьСтарыеДанныеДляУведомления();

    Если СтарыеДанные.ЭтоНовый Тогда
	
	    Текст = "Запланировано новое обслуживание клиента." + Символы.ПС
			    + "Клиент: "      + Строка(ВКМ_Клиент)     + Символы.ПС
			    + "Договор: "     + Строка(ВКМ_Договор)    + Символы.ПС
			    + "Специалист: "  + Строка(ВКМ_Специалист) + Символы.ПС
			    + "Дата: "        + Формат(ВКМ_ДатаПроведенияРабот, "ДФ=dd.MM.yyyy") + Символы.ПС
			    + "Время: "       + Формат(ВКМ_ВремяНачалаРабот, "ДФ=HH:mm")
			    + " - " + Формат(ВКМ_ВремяОкончанияРабот, "ДФ=HH:mm");
		ВКМ_ЗаписатьУведомление(Текст);
	    Возврат;

    КонецЕсли;

    ИзмененаДата          = (СтарыеДанные.ДатаПроведенияРабот <> ВКМ_ДатаПроведенияРабот);
    ИзмененоВремяНачала   = (СтарыеДанные.ВремяНачалаРабот     <> ВКМ_ВремяНачалаРабот);
    ИзмененоВремяОкончания = (СтарыеДанные.ВремяОкончанияРабот  <> ВКМ_ВремяОкончанияРабот);
    ИзмененСпециалист     = (СтарыеДанные.Специалист            <> ВКМ_Специалист);

    Если Не (ИзмененаДата Или ИзмененоВремяНачала
            Или ИзмененоВремяОкончания Или ИзмененСпециалист) Тогда
        Возврат;
    КонецЕсли;

    Текст = "Изменено обслуживание клиента." + Символы.ПС;

    Если ИзмененаДата Тогда
        Текст = Текст + "Дата: "
            + Формат(СтарыеДанные.ДатаПроведенияРабот, "ДФ=dd.MM.yyyy")
            + " -> " + Формат(ВКМ_ДатаПроведенияРабот, "ДФ=dd.MM.yyyy") + Символы.ПС;
    КонецЕсли;

    Если ИзмененоВремяНачала Тогда
        Текст = Текст + "Время начала: "
            + Формат(СтарыеДанные.ВремяНачалаРабот, "ДФ=HH:mm")
            + " -> " + Формат(ВКМ_ВремяНачалаРабот, "ДФ=HH:mm") + Символы.ПС;
    КонецЕсли;

    Если ИзмененоВремяОкончания Тогда
        Текст = Текст + "Время окончания: "
            + Формат(СтарыеДанные.ВремяОкончанияРабот, "ДФ=HH:mm")
            + " -> " + Формат(ВКМ_ВремяОкончанияРабот, "ДФ=HH:mm") + Символы.ПС;
    КонецЕсли;

    Если ИзмененСпециалист Тогда
        Текст = Текст + "Специалист: "
            + Строка(СтарыеДанные.Специалист)
            + " -> " + Строка(ВКМ_Специалист) + Символы.ПС;
    КонецЕсли;

    ВКМ_ЗаписатьУведомление(Текст);

КонецПроцедуры

Функция ВКМ_ПолучитьСтарыеДанныеДляУведомления()

    Результат = Новый Структура;
    Результат.Вставить("ЭтоНовый", Этоновый());

    Если Этоновый() Тогда
        Возврат Результат;
    КонецЕсли;

    СтарыйОбъект = Ссылка.ПолучитьОбъект();

    Результат.Вставить("ДатаПроведенияРабот", СтарыйОбъект.ВКМ_ДатаПроведенияРабот);
    Результат.Вставить("ВремяНачалаРабот",     СтарыйОбъект.ВКМ_ВремяНачалаРабот);
    Результат.Вставить("ВремяОкончанияРабот",  СтарыйОбъект.ВКМ_ВремяОкончанияРабот);
    Результат.Вставить("Специалист",           СтарыйОбъект.ВКМ_Специалист);

    Возврат Результат;

КонецФункции

Процедура ВКМ_ЗаписатьУведомление(ТекстСообщения)

    Уведомление = Справочники.ВКМ_УведомленияТелеграмБоту.СоздатьЭлемент();
    Уведомление.ВКМ_ТекстСообщения = ТекстСообщения;
    Уведомление.Записать();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
